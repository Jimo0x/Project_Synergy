# Clés Supabase (déjà configurées dans .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://iyjpqhvdlffzkrfcocrz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service_role : Dashboard Supabase > Project Settings > API
# USAGE STRICTEMENT SERVEUR (webhooks, server actions). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# FedaPay — https://sandbox.fedapay.com (compte sandbox gratuit)
# Dashboard > API > clé secrète (sk_sandbox_... / sk_live_...)
FEDAPAY_SECRET_KEY=
# Webhook : requis en PRODUCTION uniquement. En local, la synchro au retour
# (/payment/return interroge l'API FedaPay directement) suffit pour tester.
# Dashboard > Webhooks > endpoint https://TON_DOMAINE/api/webhooks/fedapay > "Click to reveal"
FEDAPAY_WEBHOOK_SECRET=
# URL publique de l'app (callback_url FedaPay) — sans slash final.
# Optionnel en local (fallback http://localhost:3000), obligatoire en production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# À venir (Phase 3b) :
